{
  "camera": {
    "name": "droidcam_http",
    "type": "rtsp",
    "source": "http://192.168.1.17:4747/video",
    "open_timeout_ms": 5000,
    "read_timeout_ms": 5000,
    "reconnect": {
      "enabled": true,
      "max_attempts": 60,
      "interval_seconds": 1.0
    }
  },
  "logging": {
    "level": "INFO",
    "file": "logs/fastvisionai.log"
  },
  "pipeline": {
    "queue": {
      "capacity": 4,
      "policy": "realtime",
      "wait_timeout_seconds": 0.5
    },
    "simulated_detector": {
      "detection_count": 1,
      "class_name": "person",
      "confidence": 0.9,
      "latency_ms": 5.0,
      "fail": false
    },
    "plugins": {
      "directories": ["plugins"],
      "continue_on_error": true,
      "enabled": [
        {
          "id": "dummy",
          "enabled": true,
          "priority": 100,
          "settings": {
            "detection_count": 1,
            "class_name": "person",
            "confidence": 0.9,
            "latency_ms": 5.0,
            "fail": false
          }
        },
        {
          "id": "person_detector",
          "enabled": false,
          "priority": 10,
          "settings": {
            "model_alias": "person_detector_default",
            "model_name": "yolov8n",
            "model_version": "8",
            "model_path": "models/yolo/yolov8n.pt",
            "confidence": 0.4,
            "iou_threshold": 0.45,
            "image_size": 640,
            "allowed_classes": [0],
            "device": "auto"
          }
        },
        {
          "id": "face_detector",
          "enabled": false,
          "priority": 10,
          "settings": {
            "confidence": 0.6,
            "nms_threshold": 0.3,
            "top_k": 5000,
            "model_alias": "face_detector_default",
            "model_path": "models/face/face_detection_yunet_2026may.onnx"
          }
        },
        {
          "id": "face_embedding",
          "enabled": false,
          "priority": 20,
          "settings": {
            "model_alias": "face_embedding_default",
            "model_name": "w600k_mbf",
            "model_version": "buffalo_sc-v0.7",
            "model_path": "models/face_embedding/w600k_mbf.onnx",
            "embedding_dimension": 512,
            "input_width": 112,
            "input_height": 112,
            "source_color": "BGR",
            "model_color": "RGB",
            "scale": 1.0,
            "mean": [127.5, 127.5, 127.5],
            "std": [127.5, 127.5, 127.5],
            "layout": "NCHW",
            "device": "auto"
          }
        }
      ]
    },
    "runtime": {
      "name": "scheduler",
      "settings": {
        "device": "auto",
        "model_aliases": ["person_detector_default"]
      }
    },
    "synthetic_frame_count": 20
  }
}
